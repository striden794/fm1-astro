# the pieces: PRESETS picks one, each remembers its settings, SAVE held resets one, all saved
# (SAMSARA's four: Samsara, Maranasati, Anatta, Nirvana)
wait 500
expect piece 0
# Samsara's pad down (the Pad page: ENV)
tap ENV
spin K1 -10
expect par0 50
# the next piece: Maranasati, its recipe (tempo 70, the Ground at 35, bells 60, Bb Mixolydian)
turn PRESET 1
expect piece 1
expect par18 70
expect par3 35
expect par1 60
expect par19 10
expect pool 0x6B5
wait 20000
shot maranasati.png
expect pad_level >10
# the pad's colour (the Pad page's fourth knob), kept with the piece (Maranasati starts as Voices)
expect par22 1
spin K4 -1
expect par22 0
wait 3000
# and Anatta (tempo 84, G Lydian), Nirvana (tempo 64, no Ground, E pentatonic major)
turn PRESET 1
expect piece 2
expect par18 84
expect par19 7
wait 8000
shot anatta.png
turn PRESET 1
expect piece 3
expect par18 64
expect par3 0
wait 8000
shot nirvana.png
# back to Samsara: as it was left
turn PRESET -3
expect par22 0
expect piece 0
expect par0 50
spin K4 1
expect par22 1
turn PRESET 1
expect par22 0
turn PRESET -1
expect par22 1
# SAVE held: Samsara's recipe again
press SAVE
wait 1700
release SAVE
expect par0 60
expect par22 0
expect store_writes 0
# a tweak, saved, survives a reboot, on the piece it was made on (the Bells page: ARP)
tap ARP
spin K1 5
expect par1 70
turn PRESET 3
expect piece 3
tap SAVE
expect store_writes 1
reboot
wait 300
expect piece 3
# one past the last piece is the first again
turn PRESET 1
expect piece 0
expect par1 70
