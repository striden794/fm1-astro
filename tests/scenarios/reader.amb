# the screen reader (fm1-reader, announce.c): a reader listens, and each page, knob, help card, button and
# chord change is said once, in the screen's own text (the words file says it in full)
wait 200
listen
wait 100
said Tide page: Mood 0, Density 20, Drift 0.38 times, Space 0. Piece Cryosleep, A Aeolian, tempo 44, growing
# (the garden follows, queued: the chord, how far to the next, the scale from the root up)
listen
where
said Scale A, B, C, D, E, F, G
# a page settles before it is said
tap ENV
wait 300
said Pad page: Level 65, Swell 90, Bright 30, Colour Glass
tap GLO
wait 300
said Setup page: Root A, Tune 0, MIDI out On, Lights On
# a knob: its name and value, once it settles
spin K2 3
wait 300
said Tune +3
spin K4 1
wait 300
said Lights Keys
spin K4 -1
wait 300
# SELECT turns the pages
turn SELECT -1
wait 300
said Space page: Echo 55, Echo time 2 bars, Reverb 85, Size 95
spin K2 -1
wait 300
said Echo time 1 bar
tap HOME
wait 300
said Tide page
spin K3 20
wait 300
said Drift 0.66 times
# HOME + SELECT: the tempo
press HOME
turn SELECT 2 200
release HOME
wait 300
said TEMPO 46
# the keys: a note out of the scale and back in; the root stays
tapkey w1
said REMOVED G
tapkey w1
said ADDED G
tapkey b3
said ADDED C#
tapkey b3
said REMOVED C#
tapkey w2
said THE ROOT STAYS (SETUP)
# the encoders: the mode, the piece (with its key and tempo)
turn ALGO 1
said MODE Pent maj
turn ALGO -1
said MODE Aeolian
turn PRESET 1
said PIECE Derelict, Eb Phrygian, tempo 52
wait 300
unsaid Level
turn PRESET -1
said PIECE Cryosleep, A Aeolian, tempo 46
wait 300
# the buttons' messages, said once
tap REC
said FREEZE ON
tap REC
said FREEZE OFF
tap PLAY
said RESTING
wait 300
unsaid GROWING
tap PLAY
said GROWING
wait 300
unsaid RESTING
tap OCT+
said BELL OCTAVE +2
tap OCT-
said BELL OCTAVE +1
tap EDIT
said NEXT CHORD ON THE BAR
# a help card: its button, then its lines
press SAVE
wait 1000
said SAVE button. SAVES ALL FOUR PIECES. KEEP HOLDING: THE PIECE BACK TO ITS RECIPE
release SAVE
tap SAVE
said SAVED
press REC
wait 1000
said REC button. FREEZE: THE CHORD HOLDS AND THE REVERB RINGS ON. AGAIN: THAW
release REC
wait 100
# the chord moving by itself: queued (said after what is being said)
wait 8000
said Chord
# a MIDI clock arriving, and start / stop from it
midi FA 00 00
midi F8 00 00
wait 20
said Tempo EXT
midi FC 00 00
wait 300
said RESTING
wait 1000
said Tempo 46
# WHERE: everything again
where
said Tide page: Mood 0, Density 20, Drift 0.66 times, Space 0. Piece Cryosleep, A Aeolian, tempo 46, resting
